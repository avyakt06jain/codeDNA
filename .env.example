# CodeDNA application state (relative to backend/ when using the documented commands)
CODEDNA_DATABASE_URL=sqlite:///./data/codedna.sqlite3
HINDSIGHT_API_URL=http://127.0.0.1:8888

# Native Hindsight service. Copy to .env and replace the placeholder locally.
HINDSIGHT_API_HOST=127.0.0.1
HINDSIGHT_API_PORT=8888
HINDSIGHT_API_DATABASE_URL=pg0
HINDSIGHT_API_WORKER_ID=codedna-local
HINDSIGHT_API_LLM_PROVIDER=gemini
HINDSIGHT_API_LLM_MODEL=gemini-3.1-flash-lite
HINDSIGHT_API_LLM_API_KEY=YOUR_GEMINI_API_KEY
